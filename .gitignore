# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- Flutter / Dart ----
app/.dart_tool/
app/.flutter-plugins*
app/.packages
app/build/
app/windows/flutter/ephemeral/
app/macos/Flutter/ephemeral/
# pubspec.lock 保留在版本控制：保证 CI analyze/test 可复现（方案 3.10）
**/GeneratedPluginRegistrant.*
**/Generated.xcconfig
app/.idea/

# ---- Node ----
node_modules/

# ---- 运行时数据（不入库；锚定仓库根，避免误伤 app/lib/data 等源码目录）----
/data/
/models/*.gguf
# templates/*.docx 为 scripts/make_templates.py 的产物，作为交付物入库

# ---- 工具状态目录 ----
.codegraph/
.deepsec/
.mimosa/

# ---- 第三方上游仓库（只本地参考/编译，不入我们的库）----
third_party/

# ---- IDE / OS ----
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store

# ---- 打包产物 ----
app/build/
app/packaging/windows/dist/
